# LLM Configuration
# Provider: "groq" (free, fast) or "openai"
GEO_LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys) — free tier, OpenAI-compatible
GROQ_API_KEY=your-groq-api-key
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (only needed if GEO_LLM_PROVIDER=openai)
OPENAI_API_KEY=
GEO_LLM_MODEL=gpt-4o-mini
GEO_MAX_LLM_TOKENS=2000

# Crawler Configuration
GEO_CRAWL_TIMEOUT=30
GEO_MAX_PAGES=20
GEO_MAX_DEPTH=2
GEO_MAX_HTML=5000000
GEO_USER_AGENT=Mozilla/5.0 (compatible; GEO-Auditor/1.0; +https://geo-auditor.dev/bot)

# Server Configuration
GEO_HOST=0.0.0.0
GEO_PORT=8000
